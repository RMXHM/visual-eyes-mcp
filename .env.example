# Copy this file to .env for local development. .env is ignored by Git.
# The server and the integration test load it automatically; variables already
# set in the shell take precedence.

GEMINI_API_KEY=replace-with-your-gemini-api-key

# Optional fallback, used only when GEMINI_API_KEY is unset or blank.
# GOOGLE_API_KEY=replace-with-your-google-api-key

# The real integration test also requires an explicit shell-level opt-in.
# This flag is intentionally not read from .env:
# VISUAL_EYES_RUN_INTEGRATION=1
